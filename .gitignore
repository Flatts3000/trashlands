.idea/
__pycache__/
*.pyc

# packwiz export artifacts - built by `packwiz curseforge export`, published from CI.
# Committing one would ship a stale pack zip that nothing regenerates.
/pack/*.zip
/pack/*.mrpack
/dist/

# Release scratch written by .github/workflows/release.yml
/release_notes.md
/cf_meta.json

# Playwright MCP writes snapshots, console logs, and screenshots into the working
# directory. Rendering the logo through Blockbench web left 14 PNGs and a base64
# dump in the repo root, and only a manual clean-up kept them out of the commit.
/.playwright-mcp/
/page-*.yml
/console-*.log

