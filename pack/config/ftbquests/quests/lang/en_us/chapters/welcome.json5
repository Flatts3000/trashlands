{
  "quest.7A55E0BA6E000010.title": "Welcome to Trashlands",
  "quest.7A55E0BA6E000010.quest_desc": [
    "A coarse dirt plain with mounds of garbage on it. No ore under it, no trees on it.",
    "",
    "Everything you build starts as a Block of Garbage you dug out of a mound.",
    "",
    "This book is nearly empty so far. The Salvager's Manual is the real guide, and the last quest here is making one.",
  ],
  "quest.7A55E0BA6E000015.title": "Join the Discord",
  "quest.7A55E0BA6E000015.quest_desc": [
    "This is an alpha and the numbers in it are first-pass. Bug reports and balance complaints are both useful.",
    "",
    "Click the Discord badge above this quest. It opens the invite in your browser.",
  ],
  "quest.7A55E0BA6E000012.title": "Pick Through the Garbage",
  "quest.7A55E0BA6E000012.quest_desc": [
    "Break a Block of Garbage out of a mound with your bare hands. No tool needed, and it falls like gravel, so mind what is above you.",
    "",
    "The value is inside it. Hold right-click on the block with an empty hand and it pulls one item at a time until it crumbles. Left-click only picks it back up; the sorting is all on the right button.",
    "",
    "What comes out is random, so this takes a few blocks.",
  ],
  "quest.7A55E0BA6E000014.title": "The Salvager's Manual",
  "quest.7A55E0BA6E000014.quest_desc": [
    "E-Scrap and Fiber Scrap, in any arrangement.",
    "",
    "The manual covers every system in the pack and is where progression is explained. Keep it on you.",
  ],
}
